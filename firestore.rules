rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Problems ──
    match /problems/{problemId} {
      allow read: if request.auth != null;
      allow write: if false; // admin-only via backend SDK
    }

    // ── Problem Test Cases ──
    match /problem_testcases/{problemId} {
      allow read: if false; // backend only
      allow write: if false;
    }

    // ── Rooms (lobbies + active matches) ──
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      // Create: any authenticated user
      allow create: if request.auth != null;
      // Update: only current participants or joining players
      allow update: if request.auth != null &&
        (resource.data.participants[request.auth.uid] != null ||
         request.resource.data.participants[request.auth.uid] != null);
      // Delete: only the creator (for lobby cleanup)
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.creatorId;
    }

    // ── Matches (permanent completed match records) ──
    match /matches/{matchId} {
      // Read: only participants of the match
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participantIds;
      // Create: any authenticated user (client writes on match completion)
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantIds;
      // No updates or deletes from client
      allow update, delete: if false;
    }

    // ── Submissions ──
    match /submissions/{submissionId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow write: if false; // backend only
    }
  }
}

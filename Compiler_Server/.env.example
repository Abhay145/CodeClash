# ─────────────────────────────────────────────────────────────
# Firebase Admin SDK
# ─────────────────────────────────────────────────────────────

# Option A — local development: point to your service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option B — production / cloud hosting (Railway, Render, etc.)
# Paste the entire service account JSON as a single-line string.
# This takes priority over FIREBASE_SERVICE_ACCOUNT_PATH when set.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────

# Port the HTTP server listens on (cloud hosts like Render set this automatically)
PORT=3000

# Comma-separated list of allowed frontend origins (in addition to localhost defaults)
# Example: CORS_ORIGINS=https://your-app.com,https://staging.your-app.com
CORS_ORIGINS=

# ─────────────────────────────────────────────────────────────
# Compiler Binaries
# ─────────────────────────────────────────────────────────────

# Paths to compiler/runtime executables.
# Leave as-is if they are already on your system PATH.
GXX_PATH=g++
GCC_PATH=gcc
JAVA_PATH=java
JAVAC_PATH=javac
PYTHON_PATH=python3

# ─────────────────────────────────────────────────────────────
# Redis  (required — used for the BullMQ job queue)
# ─────────────────────────────────────────────────────────────

# Full ioredis-compatible URL.
# Local:    redis://localhost:6379
# Upstash:  rediss://default:<token>@<host>:6380
REDIS_URL=redis://localhost:6379

# Individual host/port (used as fallback if REDIS_URL is not set)
REDIS_HOST=localhost
REDIS_PORT=6379
